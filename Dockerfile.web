FROM node:22-alpine AS dev

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci && npx prisma generate

EXPOSE 4000
CMD ["npm", "run", "dev"]

FROM dev AS builder

COPY . .

ARG APP_COMMIT_SHA=""
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build && npm prune --omit=dev && npx prisma generate && npm cache clean --force

FROM node:22-alpine AS runner

WORKDIR /app

ARG APP_COMMIT_SHA=""
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}

RUN chown node:node /app
COPY --from=builder --chown=node:node /app/package*.json ./
COPY --from=builder --chown=node:node /app/next.config.js ./
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/prisma ./prisma
COPY --from=builder --chown=node:node /app/src/app/about/stitch.html ./src/app/about/stitch.html

USER node

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 4000) + '/api/health?scope=web').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["npm", "start"]
