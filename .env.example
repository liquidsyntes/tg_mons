# ==========================================
# TG Monitor Configuration
# ==========================================

# Database Connection URL (PostgreSQL 15+ с расширением pg_trgm; SQLite не поддерживается)
# Для запуска на хосте (localhost / 127.0.0.1):
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/tgmon?schema=public"
# Для запуска внутри Docker Compose (сервис postgres):
# DATABASE_URL="postgresql://postgres:password@postgres:5432/tgmon?schema=public"

# Telegram MTProto API Credentials (получите на https://my.telegram.org в разделе 'API development tools')
TG_API_ID="1234567"
TG_API_HASH="0123456789abcdef0123456789abcdef"

# Номер телефона аккаунта сборщика (в международном формате, например +79991234567)
TG_PHONE="+79991234567"

# Строка активной сессии MTProto (генерируется автоматически через `npm run auth`)
TG_SESSION=""

# Расписание сбора метрик (cron-формат, по умолчанию раз в час: 0 * * * *)
COLLECT_CRON="0 * * * *"

# Расписание сбора демографии аудитории (cron-формат, по умолчанию воскресенье 03:00 UTC)
DEMOGRAPHICS_CRON="0 3 * * 0"

# Запуск первичного сбора при старте воркера (true / false)
COLLECT_ON_STARTUP="true"

# URL for internal API calls from worker to web (e.g., http://localhost:4000 или http://web:4000 в Docker)
WEB_INTERNAL_URL="http://localhost:4000"

# Bearer-токен для ручного запуска сбора через POST /api/collect/run
# ВАЖНО: Не используйте "supersecrettoken" в production!
# Для случайной строки: openssl rand -hex 16
COLLECT_API_TOKEN=""

# Не используется кодом (канал назначается через UI или API):
# MY_CHANNEL_USERNAME=""

# Alert settings (для уведомлений об аномалиях)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
OPENROUTER_API_KEY=""

# Timeout for MTProto network requests (in ms)
TELEGRAM_REQUEST_TIMEOUT_MS=30000

# Порог последовательных ошибок для автоотключения канала (по умолчанию 10)
CHANNEL_MAX_CONSECUTIVE_ERRORS=10

# Пороги для проверки работоспособности фонового сбора (/api/health в минутах)
HEALTH_STUCK_THRESHOLD_MINUTES=120
HEALTH_STALE_THRESHOLD_MINUTES=720
