# ==========================================
# TG Monitor Configuration
# ==========================================

# Database Connection URL
# По умолчанию: SQLite (не требует отдельного сервера БД)
# Для локального запуска: file:./dev.db
# Для Docker: file:./data/dev.db (с volume mount)
# Для PostgreSQL: postgresql://postgres:password@localhost:5432/tg_monitor?schema=public
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/tgmon?schema=public"

# Telegram MTProto API Credentials (получите на https://my.telegram.org в разделе 'API development tools')
TG_API_ID="1234567"
TG_API_HASH="0123456789abcdef0123456789abcdef"

# Номер телефона аккаунта сборщика (в международном формате, например +79991234567)
TG_PHONE="+79991234567"

# Строка активной сессии MTProto (генерируется автоматически через `npm run auth`)
TG_SESSION=""

# Расписание сбора метрик (cron-формат, по умолчанию раз в час: 0 * * * *)
COLLECT_CRON="0 * * * *"

# Запуск первичного сбора при старте воркера (true / false)
COLLECT_ON_STARTUP="true"

# Секретный Bearer-токен для ручного запуска сбора через POST /api/collect/run
# ВНИМАНИЕ: Не используйте "supersecrettoken" в production!
# Сгенерируйте случайную строку: openssl rand -hex 16
COLLECT_API_TOKEN="supersecrettoken"

# Начальный юзернейм «Моего канала» (опционально)
MY_CHANNEL_USERNAME=""

# Alert settings (для уведомлений об аномалиях)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
OPENROUTER_API_KEY=""
