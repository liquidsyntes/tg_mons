datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Channel {
  id                   Int                  @id @default(autoincrement())
  username             String?              @unique
  tgId                 BigInt?              @unique
  title                String
  type                 String // "channel" | "group"
  niche                String               @default("general")
  isMine               Boolean              @default(false)
  isFavorite           Boolean              @default(false)
  isActive             Boolean              @default(true)
  consecutiveErrors    Int                  @default(0)
  lastMessageId        BigInt?
  lastError            String?
  lastCollectedAt      DateTime?
  createdAt            DateTime             @default(now())
  snapshots            Snapshot[]
  posts                Post[]
  aiReports            AiReport[]
  mentions             Mention[]
  channelMetricDailies ChannelMetricDaily[]
  demographics         AudienceDemographics[]
  alertRules           AlertRule[]
  fraudSignals         FraudSignal[]

  @@map("channels")
}

model AiReport {
  id        Int      @id @default(autoincrement())
  channelId Int?     @map("channel_id")
  type      String // "summary" | "compare" | "trend"
  content   String // The JSON string payload
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("ai_reports")
}

model Snapshot {
  id           Int      @id @default(autoincrement())
  channelId    Int      @map("channel_id")
  membersCount Int      @map("members_count")
  collectedAt  DateTime @default(now()) @map("collected_at")
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, collectedAt])
  @@map("snapshots")
}

model Post {
  id            Int            @id @default(autoincrement())
  channelId     Int            @map("channel_id")
  messageId     BigInt         @map("message_id")
  groupedId     BigInt?        @map("grouped_id")
  publishedAt   DateTime       @map("published_at")
  views         Int?
  reactions     Int?
  comments      Int?
  forwards      Int?
  text          String?
  subscribersAtPublish Int?    @map("subscribers_at_publish")
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mentions      Mention[]
  snapshots     PostSnapshot[]
  eventMentions EventMention[]

  @@unique([channelId, messageId])
  @@index([channelId, groupedId])
  @@index([channelId, publishedAt])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("posts")
}

model PostSnapshot {
  id          Int      @id @default(autoincrement())
  postId      Int      @map("post_id")
  views       Int
  collectedAt DateTime @default(now()) @map("collected_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, collectedAt])
  @@map("post_snapshots")
}

model Mention {
  id              Int      @id @default(autoincrement())
  sourcePostId    Int      @map("source_post_id")
  sourceChannelId Int      @map("source_channel_id")
  targetUsername  String?  @map("target_username")
  targetTgId      BigInt?  @map("target_tg_id")
  type            String // "forward" | "mention"
  createdAt       DateTime @default(now()) @map("created_at")

  sourcePost    Post    @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)
  sourceChannel Channel @relation(fields: [sourceChannelId], references: [id], onDelete: Cascade)

  @@index([sourceChannelId])
  @@index([targetUsername])
  @@map("mentions")
}

enum SyncStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model SyncJob {
  id                Int        @id @default(autoincrement())
  startedAt         DateTime
  endedAt           DateTime?
  status            SyncStatus
  channelsTotal     Int        @default(0)
  channelsSucceeded Int        @default(0)
  channelsFailed    Int        @default(0)
  postsAdded        Int        @default(0)
  durationMs        Int?
  errorSummary      String?
  createdAt         DateTime   @default(now())

  @@map("sync_jobs")
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime // Date of the event
  timeStr   String? // Exact time string if any, e.g., '22:00 - 05:00'
  organizer String?
  prices    Json? // Storing categories of prices
  createdAt DateTime @default(now())

  mentions EventMention[]

  @@map("events")
}

model EventMention {
  id      Int @id @default(autoincrement())
  eventId Int @map("event_id")
  postId  Int @map("post_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([eventId, postId])
  @@index([eventId])
  @@index([postId])
  @@map("event_mentions")
}

model ChannelMetricDaily {
  id         Int      @id @default(autoincrement())
  channelId  Int      @map("channel_id")
  date       DateTime @db.Date
  followers  Int
  avgViews   Int
  vr         Float
  err        Float
  postsCount Int

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([date])
  @@map("channel_metrics_daily")
}

model AudienceDemographics {
  id                Int      @id @default(autoincrement())
  channelId         Int      @map("channel_id")
  capturedAt        DateTime @default(now()) @map("captured_at")
  languageBreakdown Json     @map("language_breakdown")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, capturedAt])
  @@map("audience_demographics")
}

model SystemSetting {
  id           String    @id @default("global")
  aiProvider   String    @default("openrouter") @map("ai_provider")
  aiModel      String    @default("meta-llama/llama-3.1-8b-instruct:free") @map("ai_model")
  aiToken      String?   @map("ai_token")
  digestEnabled Boolean  @default(false) @map("digest_enabled")
  digestHour   Int       @default(9) @map("digest_hour")
  lastDigestAt DateTime? @map("last_digest_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AlertRule {
  id          Int       @id @default(autoincrement())
  channelId   Int?      @map("channel_id")
  metric      String // "followers" | "delta24h" | "delta7d" | "er7d" | "err7d" | "vr7d" | "avgViews7d" | "posts7d" | "contentScore"
  operator    String // "lt" | "gt"
  threshold   Float
  enabled     Boolean   @default(true)
  lastFiredAt DateTime? @map("last_fired_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("alert_rules")
}

model FraudSignal {
  id         Int      @id @default(autoincrement())
  channelId  Int      @map("channel_id")
  signalType String   @map("signal_type")
  value      Float
  reason     String
  detectedAt DateTime @default(now()) @map("detected_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, detectedAt])
  @@map("fraud_signals")
}
