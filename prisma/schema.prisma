datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Channel {
  id              Int        @id @default(autoincrement())
  username        String?    @unique
  tgId            BigInt?    @unique
  title           String
  type            String     // "channel" | "group"
  niche           String     @default("general")
  isMine          Boolean    @default(false)
  isFavorite      Boolean    @default(false)
  isActive        Boolean    @default(true)
  consecutiveErrors Int        @default(0)
  lastMessageId   BigInt?
  lastError       String?
  lastCollectedAt DateTime?
  createdAt       DateTime   @default(now())
  snapshots       Snapshot[]
  posts           Post[]
  aiReports       AiReport[]
  mentions        Mention[]

  @@map("channels")
}

model AiReport {
  id        Int      @id @default(autoincrement())
  channelId Int?     @map("channel_id")
  type      String   // "summary" | "compare" | "trend"
  content   String   // The JSON string payload
  createdAt DateTime @default(now()) @map("created_at")

  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("ai_reports")
}

model Snapshot {
  id           Int      @id @default(autoincrement())
  channelId    Int      @map("channel_id")
  membersCount Int      @map("members_count")
  collectedAt  DateTime @default(now()) @map("collected_at")
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, collectedAt])
  @@map("snapshots")
}

model Post {
  id          Int      @id @default(autoincrement())
  channelId   Int      @map("channel_id")
  messageId   BigInt   @map("message_id")
  publishedAt DateTime @map("published_at")
  views       Int?
  reactions   Int?
  comments    Int?
  forwards    Int?
  text        String?
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mentions    Mention[]
  snapshots   PostSnapshot[]

  @@unique([channelId, messageId])
  @@index([channelId, publishedAt])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("posts")
}

model PostSnapshot {
  id          Int      @id @default(autoincrement())
  postId      Int      @map("post_id")
  views       Int
  collectedAt DateTime @default(now()) @map("collected_at")

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, collectedAt])
  @@map("post_snapshots")
}

model Mention {
  id              Int      @id @default(autoincrement())
  sourcePostId    Int      @map("source_post_id")
  sourceChannelId Int      @map("source_channel_id")
  targetUsername  String?  @map("target_username")
  targetTgId      BigInt?  @map("target_tg_id")
  type            String   // "forward" | "mention"
  createdAt       DateTime @default(now()) @map("created_at")

  sourcePost      Post     @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)
  sourceChannel   Channel  @relation(fields: [sourceChannelId], references: [id], onDelete: Cascade)

  @@index([sourceChannelId])
  @@index([targetUsername])
  @@map("mentions")
}


enum SyncStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model SyncJob {
  id                Int        @id @default(autoincrement())
  startedAt         DateTime
  endedAt           DateTime?
  status            SyncStatus
  channelsTotal     Int        @default(0)
  channelsSucceeded Int        @default(0)
  channelsFailed    Int        @default(0)
  postsAdded        Int        @default(0)
  durationMs        Int?
  errorSummary      String?
  createdAt         DateTime   @default(now())

  @@map("sync_jobs")
}

