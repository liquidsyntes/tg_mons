datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Channel {
  id              Int        @id @default(autoincrement())
  username        String?    @unique
  tgId            BigInt?    @unique
  title           String
  type            String     // "channel" | "group"
  isMine          Boolean    @default(false)
  isFavorite      Boolean    @default(false)
  isActive        Boolean    @default(true)
  lastMessageId   BigInt?
  lastError       String?
  lastCollectedAt DateTime?
  createdAt       DateTime   @default(now())
  snapshots       Snapshot[]
  posts           Post[]
  aiReports       AiReport[]

  @@map("channels")
}

model AiReport {
  id        Int      @id @default(autoincrement())
  channelId Int?     @map("channel_id")
  type      String   // "summary" | "compare" | "trend"
  content   String   // The JSON string payload
  createdAt DateTime @default(now()) @map("created_at")

  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("ai_reports")
}

model Snapshot {
  id           Int      @id @default(autoincrement())
  channelId    Int      @map("channel_id")
  membersCount Int      @map("members_count")
  collectedAt  DateTime @default(now()) @map("collected_at")
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, collectedAt])
  @@map("snapshots")
}

model Post {
  id          Int      @id @default(autoincrement())
  channelId   Int      @map("channel_id")
  messageId   BigInt   @map("message_id")
  publishedAt DateTime @map("published_at")
  views       Int?
  text        String?
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([channelId, publishedAt])
  @@index([channelId, publishedAt, text])
  @@map("posts")
}
