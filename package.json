{
  "name": "tg-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "worker": "npx tsx src/worker/index.ts",
    "auth": "npx tsx src/worker/auth.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "npx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "html2canvas-pro": "^2.3.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.25",
    "node-cron": "^4.6.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "core-js@3.50.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@5.0.10": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
